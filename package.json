{
  "name": "chatapp",
  "version": "1.1.0",
  "private": true,
  "description": "Single-instance chat backend with transactional media ownership and session revocation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js",
    "test": "node --test test.js",
    "audit:prod": "npm audit --omit=dev"
  },
  "engines": { "node": ">=24 <25" },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "winston": "^3.17.0"
  },
  "overrides": { "socket.io-parser": "^4.2.6" },
  "devDependencies": { "nodemon": "^3.1.10" }
}

{
  "name": "chatapp",
  "version": "1.10.5",
  "private": true,
  "description": "Minimal private chat with groups, calls and secure photo, ZIP, MP3 and MP4 sharing",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check.cjs",
    "test": "node scripts/check.cjs && node --test tests/attachments.cjs tests/settings.cjs tests/password-settings.cjs tests/electron.cjs tests/audit.cjs",
    "audit:prod": "npm audit --omit=dev",
    "test:e2e": "node tests/browser.cjs",
    "test:attachments": "node --test tests/attachments.cjs",
    "test:legacy": "node --test test.js tests/redesign.cjs tests/voice.cjs",
    "electron": "electron .",
    "electron:dev": "electron ."
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "winston": "^3.17.0"
  },
  "overrides": {
    "socket.io-parser": "^4.2.6",
    "qs": "^6.16.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "playwright": "^1.58.0",
    "electron": "^31.0.0"
  }
}

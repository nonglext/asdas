{
  "name": "chatapp",
  "version": "1.7.0",
  "private": true,
  "description": "Discord-inspired chat UI with resilient session storage and accessible conversation controls",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check.cjs",
    "test": "node --test test.js tests/voice.cjs tests/audit.cjs tests/redesign.cjs",
    "audit:prod": "npm audit --omit=dev",
    "test:e2e": "node tests/browser.cjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "winston": "^3.17.0"
  },
  "overrides": {
    "socket.io-parser": "^4.2.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "playwright": "^1.58.0"
  }
}
